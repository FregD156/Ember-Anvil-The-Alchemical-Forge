; but it can be also edited, but don't delete it!

config_version=5

[application]

config/name="Ember & Anvil: The Alchemical Forge"
run/main_scene="res://scenes/world/world_main.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")

[autoload]

GameConstants="*res://autoload/game_constants.gd"
TimeManager="*res://autoload/time_manager.gd"
EventBus="*res://autoload/event_bus.gd"
GameManager="*res://autoload/game_manager.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/scale_mode="integer"

